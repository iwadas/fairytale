# Backend configuration (read by app/core/config.py -> AppSettings).
# Copy to backend/.env and adjust. Real environment variables override this file.
# Every variable is optional; the values below are the built-in defaults.

# --- Database ---
# SQLAlchemy async URL. Relative SQLite paths resolve against the CWD (run from backend/).
# Alembic (migrations/env.py) uses the same URL with the sync driver.
DATABASE_URL=sqlite+aiosqlite:///./film.db
# Log every SQL statement (true/false).
SQL_ECHO=false

# --- HTTP ---
# Allowed CORS origins as a JSON list, e.g. ["http://localhost:5173"].
CORS_ORIGINS=["*"]

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR. DEBUG also logs full LLM prompts/responses.
LOG_LEVEL=INFO

# --- Static files / media output directories (CWD-relative) ---
# Directory mounted at /static.
STATIC_DIR=static
# Uploaded / generated scene videos.
SCENE_VIDEO_DIR=static/videos/scenes
# Uploaded scene images.
SCENE_IMAGE_DIR=static/images/scenes
# Uploaded music files.
MUSIC_DIR=static/music
# Generated TTS voiceovers.
VOICEOVER_DIR=voiceovers
# Final rendered project videos (POST /projects/download/{id}).
RENDER_OUTPUT_DIR=videos

# --- External tools ---
# Remotion app used for karaoke subtitle overlays (default: <repo>/services/render-engine/remotion-app).
# REMOTION_APP_DIR=

# --- Provider API keys (keys stored in DB settings via the UI are used where the code prefers them) ---
# OpenAI key (legacy translations module).
OPENAI_API_KEY=
# xAI key (legacy generators/story pipeline clients created at import time).
XAI_API_KEY=
# Groq key (word timestamps for generated voiceovers).
GROQ_API_KEY=
# Runware key (scene video generation; overrides the key stored in DB settings).
RUNWARE_API_KEY=

# --- Third-party endpoints ---
# OpenAI-compatible base URL for xAI.
XAI_BASE_URL=https://api.x.ai/v1
