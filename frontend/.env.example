# Copy to .env.local (gitignored) and adjust. Read only in src/config.js.
# Restart `npm run serve` after changing.

# Backend HTTP base URL (REST API and /static media). No trailing slash.
VUE_APP_API_URL=http://localhost:8000

# Backend WebSocket base URL. Optional: defaults to VUE_APP_API_URL with http(s) -> ws(s).
VUE_APP_WS_URL=ws://localhost:8000
